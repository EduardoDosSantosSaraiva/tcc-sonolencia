# Ambiente virtual (recriado com requirements.txt)
venv/
__pycache__/
*.pyc
.pytest_cache/

# Modelos baixados — ver README (baixar_modelos.sh)
face_landmarker.task
tts_model/

# Dados gerados em execução
sonolencia.db
sonolencia.db-shm
sonolencia.db-wal
calibracao_log.txt
latencias.csv

# Fotos do rosto do condutor capturadas nos alarmes.
# Nunca versionar: são dados biométricos (LGPD, art. 5º, II).
alarme_snapshots/

# Saídas geradas a partir dos .md da monografia (ver gerar_html.py / gerar_pdf.py)
monografia/*.html
monografia/*.pdf

# Falas pré-gravadas: geradas por gerar_vozes.py (sem elas, o Piper sintetiza na hora)
vozes/

# Resultados da avaliação no YawDD: gerados por avaliar_yawdd.py a partir
# dos vídeos do dataset (que não pode ser redistribuído)
avaliacao_yawdd/

# Saída do início automático (iniciar_no_boot.sh)
logs/

# Vídeos de teste do próprio motorista (gravar_angulos.py): rosto = dado biométrico
videos_proprios/
